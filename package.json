{
	"name": "com.mrlectus.expo",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"format": "prettier --write \"**/*.{ts,tsx,md}\"",
		"check-types": "turbo run check-types"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.1",
		"@types/bun": "latest",
		"@types/node": "latest",
		"prettier": "^3.8.4",
		"sherif": "^1.11.1",
		"tsc-alias": "^1.8.17",
		"tsdown": "^0.22.2",
		"turbo": "^2.9.17",
		"typescript": "latest"
	},
	"packageManager": "pnpm@11.5.3",
	"engines": {
		"node": ">=18"
	},
	"sherif": {
		"fix": false,
		"select": "highest",
		"noInstall": false,
		"failOnWarnings": false,
		"ignoreDependency": [],
		"ignorePackage": [],
		"ignoreRule": []
	},
	"version": "1.0.0"
}
